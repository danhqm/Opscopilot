# Shared infrastructure
MYSQL_DATABASE=ops_copilot
MYSQL_USER=ops_copilot
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql://ops_copilot:change-me-local@mysql:3306/ops_copilot
REDIS_URL=redis://redis:6379

# API gateway
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:8080
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
JWT_ISSUER=ops-copilot-api
JWT_AUDIENCE=ops-copilot-web
RATE_LIMIT_GLOBAL_MAX=240
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ACTION_MAX=30

# Internal services
AGENT_SERVICE_URL=http://agent-service:8000
WORKFLOW_EXECUTION_TIMEOUT_MS=300000
MCP_SERVER_URL=http://mcp-server:8100
CHROMA_URL=http://chromadb:8000
INTERNAL_API_TOKEN=replace-with-an-internal-service-token
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=15728640

# Frontend (browser-visible)
NEXT_PUBLIC_API_URL=/api

# AI models
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_HISTORY_MESSAGES=24
AGENT_MAX_TURNS=8
WEBHOOK_TIMEOUT_SECONDS=10
