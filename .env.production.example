# Store the completed contents as a version of the GCP Secret Manager secret
# ops-copilot-production-env. The VM reads that version with its runtime identity.
# Never commit the real .env.production file.

MYSQL_DATABASE=ops_copilot
MYSQL_USER=ops_copilot
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=ops-copilot-api
JWT_AUDIENCE=ops-copilot-web
RATE_LIMIT_GLOBAL_MAX=240
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_ACTION_MAX=30

INTERNAL_API_TOKEN=replace-with-a-long-random-internal-service-token
MAX_UPLOAD_BYTES=15728640
WORKFLOW_EXECUTION_TIMEOUT_MS=300000

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_HISTORY_MESSAGES=24
AGENT_MAX_TURNS=8
WEBHOOK_TIMEOUT_SECONDS=10
